# Copy to .env and adjust.

# DB: sqlite in dev (zero setup), postgres in prod
DATABASE_URL=sqlite+aiosqlite:///./esport.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/esport

# LoL source (raw unofficial lolesports endpoints) — well-known public key
LOL_API_KEY=0TvQnueqKa5mxJntVWt0w4LpLfEkrV1Ta8rQBb9Z
LOL_API_BASE=https://esports-api.lolesports.com/persisted/gw
LOL_FEED_BASE=https://feed.lolesports.com/livestats/v1
HL=en-US

# Cadences (seconds)
POLL_LIVE_INTERVAL=30
POLL_FRAME_INTERVAL=10

# Live push (WebSocket /live/{game_id})
# Prod (separate worker + api processes): set REDIS_URL so the bus bridges them.
# REDIS_URL=redis://localhost:6379/0
# Dev single-process: run ingestion inside the API so live push works without Redis.
RUN_WORKER_IN_API=false
